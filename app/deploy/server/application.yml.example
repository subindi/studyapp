# ~/sseuro/config/application.yml (이 파일을 복사해 값을 채우고 chmod 600)
# Spring Boot 하나로 화면(web/) + API 를 9092 번에서 서비스한다 (nginx · sudo 없이, 9090 포켓 스도쿠 · 9091 은 사용 안 함)
server:
  port: 9092
  servlet:
    session:
      cookie:
        secure: false   # HTTPS 가 아니라서. 도메인 · HTTPS 를 붙이면 true

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/ciat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
    username: ciat
    password: "CHANGE_ME"
    hikari:
      maximum-pool-size: 5
  web:
    resources:
      static-locations: file:/home/ciat/sseuro/web/
  flyway:
    # 업무 DB(ciat) 안에 함께 둔다. 테이블은 모두 ss_ 접두어 (기존 TB_* · 포켓 스도쿠 테이블은 건드리지 않음)
    baseline-on-migrate: true
    baseline-version: 0
    table: sseuro_flyway_history

logging:
  file:
    name: /home/ciat/sseuro/logs/app.log
  logback:
    rollingpolicy:
      max-file-size: 10MB
      max-history: 7
